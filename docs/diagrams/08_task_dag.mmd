%% Hourly ELT task DAG (snowflake/07_streams_tasks/03_task_dag.sql)
flowchart TD
  ROOT[T_ROOT_CV_HOURLY<br/>CRON 5 * * * * UTC] --> SH[T_STAGE_CLAIM_HEADER<br/>SP_MERGE_CLAIM_HEADER]
  SH --> SC[T_STAGE_CLAIM_LINE<br/>SP_STAGE_CLAIM_LINE]
  SH --> RO[T_REPLAY_ORPHANS]
  ROOT --> SM[T_STAGE_MEMBER]
  ROOT --> SE[T_STAGE_ELIGIBILITY]
  ROOT --> DP[T_CORE_DIM_PROVIDER SCD2]
  SM --> DM[T_CORE_DIM_MEMBER SCD2]
  SE --> FE[T_CORE_FACT_ELIG_MONTH]
  DM --> FE
  SC & DM & DP --> FC[T_CORE_FACT_CLAIM_LINE]
  FC & FE --> PG[T_DQ_AND_PUBLISH_GATE<br/>SP_RUN_DQ + SP_PUBLISH_GATE]
  ROOT -. finalizer .-> FIN[T_FINALIZER_AUDIT]
  PG -. PASSED resumes .-> DT[MART Dynamic Tables]
