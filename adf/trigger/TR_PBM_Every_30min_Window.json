{
    "name": "TR_PBM_Every_30min_Window",
    "properties": {
        "type": "ScheduleTrigger",
        "runtimeState": "Started",
        "description": "PBM files arrive 03:00-07:00 ET; SFTP has no events, so poll every 30 min in that window.",
        "pipelines": [
            {
                "pipelineReference": {
                    "referenceName": "PL_12_File_Ingest_SFTP",
                    "type": "PipelineReference"
                },
                "parameters": {
                    "business_date": "@formatDateTime(addDays(convertFromUtc(trigger().scheduledTime,'Eastern Standard Time'),-1),'yyyy-MM-dd')"
                }
            }
        ],
        "typeProperties": {
            "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "startTime": "2026-06-14T03:00:00",
                "timeZone": "Eastern Standard Time",
                "schedule": {
                    "hours": [
                        3,
                        4,
                        5,
                        6
                    ],
                    "minutes": [
                        0,
                        30
                    ]
                }
            }
        }
    }
}
