{
    "name": "DS_Sftp_Binary",
    "properties": {
        "type": "Binary",
        "linkedServiceName": {
            "referenceName": "LS_Sftp_PBM",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "folder_path": {
                "type": "string",
                "defaultValue": "/outbound/carevista"
            },
            "file_name": {
                "type": "string",
                "defaultValue": ""
            }
        },
        "typeProperties": {
            "location": {
                "type": "SftpLocation",
                "folderPath": {
                    "value": "@dataset().folder_path",
                    "type": "Expression"
                },
                "fileName": {
                    "value": "@dataset().file_name",
                    "type": "Expression"
                }
            }
        }
    }
}
