<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic, simplified PowerCenter 10.x repository export (pmrep objectexport) for the CLAIMS folder.
     Structure mirrors real exports; content is fictional. -->
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="06/01/2025 02:14:11" REPOSITORY_VERSION="186.95">
<REPOSITORY NAME="REP_CV_PROD" VERSION="186" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="CLAIMS" GROUP="" OWNER="infa_admin" SHARED="NOTSHARED" DESCRIPTION="Claims EDW loads">

  <SOURCE NAME="CLM_LINE" DATABASETYPE="Microsoft SQL Server" DBDNAME="CLAIMS_PROD" OWNERNAME="dbo">
    <SOURCEFIELD NAME="CLAIM_ID" DATATYPE="varchar" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="PRIMARY KEY"/>
    <SOURCEFIELD NAME="LINE_NO" DATATYPE="smallint" PRECISION="5" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="PRIMARY KEY"/>
    <SOURCEFIELD NAME="PAID_AMT" DATATYPE="decimal" PRECISION="15" SCALE="2" NULLABLE="NULL" KEYTYPE="NOT A KEY"/>
    <SOURCEFIELD NAME="ADJUSTMENT_TYPE" DATATYPE="char" PRECISION="2" SCALE="0" NULLABLE="NULL" KEYTYPE="NOT A KEY"/>
  </SOURCE>
  <SOURCE NAME="CLM_HDR" DATABASETYPE="Microsoft SQL Server" DBDNAME="CLAIMS_PROD" OWNERNAME="dbo">
    <SOURCEFIELD NAME="CLAIM_ID" DATATYPE="varchar" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="PRIMARY KEY"/>
    <SOURCEFIELD NAME="MEMBER_ID" DATATYPE="varchar" PRECISION="20" SCALE="0" NULLABLE="NULL" KEYTYPE="NOT A KEY"/>
  </SOURCE>
  <TARGET NAME="CLAIM_LINE_FACT" DATABASETYPE="Oracle" CONSTRAINT="" TABLEOPTIONS="">
    <TARGETFIELD NAME="CLM_ID" DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="PRIMARY KEY"/>
    <TARGETFIELD NAME="PD_AMT" DATATYPE="number" PRECISION="15" SCALE="2" NULLABLE="NULL" KEYTYPE="NOT A KEY"/>
  </TARGET>
  <TARGET NAME="CLAIM_LINE_ERR" DATABASETYPE="Oracle"/>

  <MAPPING NAME="m_CLM_CLAIM_LINE_LOAD" DESCRIPTION="Daily claim line load into EDW.CLAIM_LINE_FACT" ISVALID="YES">
    <TRANSFORMATION NAME="SQ_CLAIM_LINE" TYPE="Source Qualifier" REUSABLE="NO">
      <TRANSFORMFIELD NAME="CLAIM_ID" DATATYPE="string" PORTTYPE="INPUT/OUTPUT" PRECISION="20"/>
      <TRANSFORMFIELD NAME="PAID_AMT" DATATYPE="decimal" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="2"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT L.*, H.MEMBER_ID, H.LOB_CODE FROM dbo.CLM_LINE L INNER JOIN dbo.CLM_HDR H ON H.CLAIM_ID = L.CLAIM_ID WHERE L.UPDATED_TS &gt; '$$LAST_EXTRACT_DT'"/>
      <TABLEATTRIBUTE NAME="Source Filter" VALUE=""/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_DERIVE" TYPE="Expression" REUSABLE="NO">
      <TRANSFORMFIELD NAME="o_PAID_AMT" DATATYPE="decimal" PORTTYPE="OUTPUT" PRECISION="15" SCALE="2"
                      EXPRESSION="IIF(ADJUSTMENT_TYPE='RV', -1 * ABS(PAID_AMT), PAID_AMT)"/>
      <TRANSFORMFIELD NAME="o_PRIM_DX" DATATYPE="string" PORTTYPE="OUTPUT" PRECISION="8"
                      EXPRESSION="REPLACESTR(0, LTRIM(RTRIM(PRIMARY_DX_CD)), '.', '')"/>
      <TRANSFORMFIELD NAME="o_SVC_DT" DATATYPE="date/time" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_DATE(SERVICE_FROM_DT_TXT, 'YYYYMMDD')"/>
      <TRANSFORMFIELD NAME="v_DATE_CHECK" DATATYPE="integer" PORTTYPE="LOCAL VARIABLE"
                      EXPRESSION="IIF(o_SVC_DT &gt; SYSDATE, 1, 0)"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="LKP_MEMBER_SK" TYPE="Lookup Procedure" REUSABLE="NO">
      <TABLEATTRIBUTE NAME="Lookup table name" VALUE="EDW.MEMBER_DIM"/>
      <TABLEATTRIBUTE NAME="Lookup condition" VALUE="MBR_ID = IN_MEMBER_ID AND CURR_IND = 'Y'"/>
      <TABLEATTRIBUTE NAME="Lookup policy on multiple match" VALUE="Use First Value"/>
      <TABLEATTRIBUTE NAME="Lookup Sql Override" VALUE="SELECT MBR_KEY, MBR_ID FROM EDW.MEMBER_DIM WHERE CURR_IND='Y' ORDER BY MBR_ID, EFF_DT DESC --"/>
      <TABLEATTRIBUTE NAME="Lookup caching enabled" VALUE="YES"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="LKP_PROVIDER_SK" TYPE="Lookup Procedure" REUSABLE="NO">
      <TABLEATTRIBUTE NAME="Lookup table name" VALUE="EDW.PROVIDER_DIM"/>
      <TABLEATTRIBUTE NAME="Lookup policy on multiple match" VALUE="Use Any Value"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="RTR_VALID" TYPE="Router" REUSABLE="NO">
      <GROUP NAME="VALID" TYPE="OUTPUT" EXPRESSION="NOT ISNULL(CLAIM_ID) AND v_DATE_CHECK = 0"/>
      <GROUP NAME="ERROR" TYPE="OUTPUT" EXPRESSION="ISNULL(CLAIM_ID) OR v_DATE_CHECK = 1"/>
      <GROUP NAME="DEFAULT1" TYPE="OUTPUT/DEFAULT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="UPD_CLAIM" TYPE="Update Strategy" REUSABLE="NO">
      <TABLEATTRIBUTE NAME="Update Strategy Expression" VALUE="IIF(ISNULL(LKP_CLM_KEY), DD_INSERT, DD_UPDATE)"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="SEQ_CLM_LINE_KEY" TYPE="Sequence" REUSABLE="YES"/>
    <INSTANCE NAME="CLM_LINE" TYPE="SOURCE" TRANSFORMATION_NAME="CLM_LINE"/>
    <INSTANCE NAME="CLM_HDR" TYPE="SOURCE" TRANSFORMATION_NAME="CLM_HDR"/>
    <INSTANCE NAME="CLAIM_LINE_FACT" TYPE="TARGET" TRANSFORMATION_NAME="CLAIM_LINE_FACT"/>
    <INSTANCE NAME="CLAIM_LINE_ERR" TYPE="TARGET" TRANSFORMATION_NAME="CLAIM_LINE_ERR"/>
    <CONNECTOR FROMINSTANCE="SQ_CLAIM_LINE" TOINSTANCE="EXP_DERIVE" FROMFIELD="PAID_AMT" TOFIELD="PAID_AMT"/>
    <CONNECTOR FROMINSTANCE="EXP_DERIVE" TOINSTANCE="RTR_VALID" FROMFIELD="o_PAID_AMT" TOFIELD="o_PAID_AMT"/>
    <CONNECTOR FROMINSTANCE="RTR_VALID" TOINSTANCE="UPD_CLAIM" FROMFIELD="o_PAID_AMT1" TOFIELD="o_PAID_AMT"/>
    <CONNECTOR FROMINSTANCE="UPD_CLAIM" TOINSTANCE="CLAIM_LINE_FACT" FROMFIELD="o_PAID_AMT" TOFIELD="PD_AMT"/>
    <MAPPINGVARIABLE NAME="$$LAST_EXTRACT_DT" DATATYPE="date/time" ISPARAM="YES" AGGFUNCTION="MAX"/>
  </MAPPING>

  <MAPPING NAME="m_CLM_DIAG_NORMALIZE" DESCRIPTION="DX1..DX12 columns to rows" ISVALID="YES">
    <TRANSFORMATION NAME="SQ_CLM_DIAG" TYPE="Source Qualifier" REUSABLE="NO"/>
    <TRANSFORMATION NAME="NRM_DX1_DX12" TYPE="Normalizer" REUSABLE="NO"/>
    <TRANSFORMATION NAME="FIL_NULL_DX" TYPE="Filter" REUSABLE="NO">
      <TABLEATTRIBUTE NAME="Filter Condition" VALUE="NOT ISNULL(DX_CD)"/>
    </TRANSFORMATION>
    <INSTANCE NAME="CLM_DIAG" TYPE="SOURCE" TRANSFORMATION_NAME="CLM_DIAG"/>
    <INSTANCE NAME="CLAIM_DIAG_BRIDGE" TYPE="TARGET" TRANSFORMATION_NAME="CLAIM_DIAG_BRIDGE"/>
  </MAPPING>

  <MAPPING NAME="m_CLM_AGG_DENIAL_DAILY" DESCRIPTION="Daily denial aggregate (truncate/insert)" ISVALID="YES">
    <TRANSFORMATION NAME="SQ_CLAIM_LINE_FACT" TYPE="Source Qualifier" REUSABLE="NO"/>
    <TRANSFORMATION NAME="AGG_DENIALS" TYPE="Aggregator" REUSABLE="NO">
      <TABLEATTRIBUTE NAME="Sorted Input" VALUE="NO"/>
    </TRANSFORMATION>
    <INSTANCE NAME="CLAIM_LINE_FACT" TYPE="SOURCE" TRANSFORMATION_NAME="CLAIM_LINE_FACT"/>
    <INSTANCE NAME="AGG_DENIAL_DAILY" TYPE="TARGET" TRANSFORMATION_NAME="AGG_DENIAL_DAILY"/>
  </MAPPING>

  <WORKFLOW NAME="wf_CLM_DAILY_CLAIMS" SCHEDULER="DAILY_0100" SERVERNAME="IS_CV_PROD">
    <SESSION NAME="s_m_CLM_CLAIM_LINE_LOAD" MAPPINGNAME="m_CLM_CLAIM_LINE_LOAD">
      <ATTRIBUTE NAME="Parameter Filename" VALUE="$PMRootDir/param/claims_daily.par"/>
      <ATTRIBUTE NAME="Commit Interval" VALUE="10000"/>
      <ATTRIBUTE NAME="Treat source rows as" VALUE="Data driven"/>
    </SESSION>
    <SESSION NAME="s_m_CLM_DIAG_NORMALIZE" MAPPINGNAME="m_CLM_DIAG_NORMALIZE"/>
    <SESSION NAME="s_m_CLM_AGG_DENIAL_DAILY" MAPPINGNAME="m_CLM_AGG_DENIAL_DAILY">
      <ATTRIBUTE NAME="Truncate target table option" VALUE="YES"/>
    </SESSION>
    <TASK NAME="ew_CLM_FILE_READY" TYPE="Event-wait"/>
    <TASK NAME="em_FAILURE" TYPE="Email"/>
  </WORKFLOW>
</FOLDER>
</REPOSITORY>
</POWERMART>
