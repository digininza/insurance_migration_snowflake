<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic, simplified PowerCenter export for the MEMBERSHIP folder. -->
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="06/01/2025 02:15:40" REPOSITORY_VERSION="186.95">
<REPOSITORY NAME="REP_CV_PROD" VERSION="186" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="MEMBERSHIP" OWNER="infa_admin" SHARED="NOTSHARED" DESCRIPTION="Enrollment and eligibility">

  <MAPPING NAME="m_MBR_MEMBER_SCD2" DESCRIPTION="Member dimension SCD Type 2 (wizard-generated, modified)" ISVALID="YES">
    <TRANSFORMATION NAME="SQ_MEMBER" TYPE="Source Qualifier" REUSABLE="NO">
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT * FROM ENRL.MEMBER WHERE LAST_UPDATE_TS &gt; TO_DATE('$$LAST_EXTRACT_DT','MM/DD/YYYY HH24:MI:SS')"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_CLEAN" TYPE="Expression" REUSABLE="NO">
      <TRANSFORMFIELD NAME="o_FIRST_NAME" DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION="INITCAP(LTRIM(RTRIM(FIRST_NAME)))"/>
      <TRANSFORMFIELD NAME="o_ZIP5" DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION="SUBSTR(REG_REPLACE(ZIP_CD,'[^0-9]',''),1,5)"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="LKP_DIM_MEMBER" TYPE="Lookup Procedure" REUSABLE="NO">
      <TABLEATTRIBUTE NAME="Lookup table name" VALUE="EDW.MEMBER_DIM"/>
      <TABLEATTRIBUTE NAME="Dynamic Lookup Cache" VALUE="YES"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_DETECT_CHANGE" TYPE="Expression" REUSABLE="NO">
      <TRANSFORMFIELD NAME="o_CHANGED" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="IIF(MD5(o_FIRST_NAME||LAST_NAME||o_ZIP5) != LKP_HASH, 1, 0)"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="RTR_NEW_CHANGED" TYPE="Router" REUSABLE="NO">
      <GROUP NAME="NEW" TYPE="OUTPUT" EXPRESSION="ISNULL(LKP_MBR_KEY)"/>
      <GROUP NAME="CHANGED" TYPE="OUTPUT" EXPRESSION="o_CHANGED = 1"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="UPD_EXPIRE" TYPE="Update Strategy" REUSABLE="NO"/>
    <TRANSFORMATION NAME="UPD_INSERT" TYPE="Update Strategy" REUSABLE="NO"/>
    <TRANSFORMATION NAME="SEQ_MEMBER_SK" TYPE="Sequence" REUSABLE="YES"/>
    <TRANSFORMATION NAME="mplt_ADDR_STANDARDIZE" TYPE="Mapplet" REUSABLE="YES"/>
    <TRANSFORMATION NAME="SP_GET_PCP" TYPE="Stored Procedure" REUSABLE="NO">
      <TABLEATTRIBUTE NAME="Stored Procedure Name" VALUE="ENRL.PKG_PCP.GET_ASSIGNED_PCP"/>
    </TRANSFORMATION>
    <INSTANCE NAME="MEMBER" TYPE="SOURCE" TRANSFORMATION_NAME="MEMBER"/>
    <INSTANCE NAME="MEMBER_DIM" TYPE="TARGET" TRANSFORMATION_NAME="MEMBER_DIM"/>
    <MAPPINGVARIABLE NAME="$$LAST_EXTRACT_DT" DATATYPE="date/time" ISPARAM="YES"/>
  </MAPPING>

  <MAPPING NAME="m_ELG_MBR_MONTHS" DESCRIPTION="Eligibility spans to member months" ISVALID="YES">
    <TRANSFORMATION NAME="SQ_ELIG" TYPE="Source Qualifier" REUSABLE="NO"/>
    <TRANSFORMATION NAME="JNR_CALENDAR" TYPE="Joiner" REUSABLE="NO"/>
    <TRANSFORMATION NAME="AGG_MBR_MONTH" TYPE="Aggregator" REUSABLE="NO"/>
    <TRANSFORMATION NAME="SRT_MEMBER" TYPE="Sorter" REUSABLE="NO"/>
    <INSTANCE NAME="ELIG_SPAN" TYPE="SOURCE" TRANSFORMATION_NAME="ELIG_SPAN"/>
    <INSTANCE NAME="AGG_MBR_MONTHS" TYPE="TARGET" TRANSFORMATION_NAME="AGG_MBR_MONTHS"/>
  </MAPPING>

  <MAPPING NAME="m_MBR_GROUP_COPY" DESCRIPTION="Straight copy of employer groups" ISVALID="YES">
    <TRANSFORMATION NAME="SQ_EMP_GROUP" TYPE="Source Qualifier" REUSABLE="NO"/>
    <INSTANCE NAME="EMP_GROUP" TYPE="SOURCE" TRANSFORMATION_NAME="EMP_GROUP"/>
    <INSTANCE NAME="GROUP_DIM_STG" TYPE="TARGET" TRANSFORMATION_NAME="GROUP_DIM_STG"/>
  </MAPPING>

  <WORKFLOW NAME="wf_MBR_MEMBERSHIP" SCHEDULER="DAILY_0030" SERVERNAME="IS_CV_PROD">
    <SESSION NAME="s_m_MBR_MEMBER_SCD2" MAPPINGNAME="m_MBR_MEMBER_SCD2"/>
    <SESSION NAME="s_m_ELG_MBR_MONTHS" MAPPINGNAME="m_ELG_MBR_MONTHS"/>
    <SESSION NAME="s_m_MBR_GROUP_COPY" MAPPINGNAME="m_MBR_GROUP_COPY"/>
  </WORKFLOW>
</FOLDER>
</REPOSITORY>
</POWERMART>
